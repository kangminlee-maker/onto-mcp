# 이 파일을 .onto/settings.json 또는 ~/.onto/settings.json으로 복사해서 사용할 수 있습니다.
# JSON처럼 생겼지만 설명을 위해 # 주석을 허용합니다.
{
  # 설정 파일 구조 버전입니다. v3는 역할마다 모델 설정을 완전히 따로 둡니다.
  # 루트 llm.default나 역할 간 상속은 사용하지 않습니다.
  "schema_version": "settings.json/v3",

  # review는 코드나 문서 등을 검토하는 기능의 설정입니다.
  "review": {
    # full은 모든 review lens를 실행합니다. 빠른 검토가 필요하면 core-axis를 사용할 수 있습니다.
    "mode": "full",

    # 기본으로 사용할 도메인 목록입니다. 비워두면 실행 시 요청과 대상에서 추론합니다.
    "domains": ["software-engineering"],

    # context는 review 대상 주변 파일을 얼마나 읽을지 정합니다.
    "context": {
      # context 수집에서 제외할 폴더나 파일 이름입니다.
      "excluded_names": [".git", "node_modules", ".onto"],

      # 디렉터리 목록을 몇 단계 깊이까지 볼지 정합니다.
      "max_listing_depth": 10,

      # 디렉터리 목록에 넣을 최대 항목 수입니다.
      "max_listing_entries": 5000,

      # 한 파일에서 prompt에 넣을 최대 줄 수입니다.
      "max_embed_lines": 300
    },

    # execution은 review를 어떤 실행 구조와 모델로 돌릴지 정합니다.
    "execution": {
      # auto는 설정과 실행 환경을 보고 Codex worker나 direct-call 경로를 자동 선택합니다.
      "executor": "auto",

      # main-workers는 현재 세션이 진행을 조율하고, lens 작업은 worker가 수행합니다.
      "topology": "main-workers",

      # controlled-lens-deliberation은 lens 의견을 모아 필요한 쟁점을 숙의하는 기본 방식입니다.
      "deliberation": "controlled-lens-deliberation",

      # actors는 review 안에서 역할별로 실제 모델 설정을 소유합니다.
      # 즉 teamlead, lens, synthesize를 서로 독립적으로 바꿀 수 있습니다.
      "actors": {
        # teamlead는 review 전체 진행과 숙의 조율을 담당합니다.
        "teamlead": {
          # main은 현재 실행 세션에서 조율한다는 뜻입니다.
          "seat": "main",

          # 이 역할이 사용할 모델 설정입니다. 다른 역할 설정을 상속하지 않습니다.
          "llm": {
            # oauth는 Codex 로그인 계정을 통해 OpenAI 모델을 사용합니다.
            "auth": "oauth",
            # provider는 사용할 모델 제공자입니다.
            "provider": "openai",
            # model은 사용할 모델 이름입니다.
            "model": "gpt-5.5",
            # effort는 추론 강도입니다. 보통 medium이면 충분합니다.
            "effort": "medium",
            # service_tier는 Codex OAuth 경로에서 사용할 응답 속도 계층입니다.
            "service_tier": "fast"
          }
        },

        # lens는 실제 검토 관점을 독립적으로 실행하는 worker 역할입니다.
        "lens": {
          # worker는 별도 격리 실행 단위에서 작업한다는 뜻입니다.
          "seat": "worker",

          # lens worker가 사용할 모델 설정입니다.
          "llm": {
            # oauth는 Codex 로그인 계정을 통해 OpenAI 모델을 사용합니다.
            "auth": "oauth",
            # provider는 사용할 모델 제공자입니다.
            "provider": "openai",
            # model은 사용할 모델 이름입니다.
            "model": "gpt-5.5",
            # effort는 추론 강도입니다. 보통 medium이면 충분합니다.
            "effort": "medium",
            # service_tier는 Codex OAuth 경로에서 사용할 응답 속도 계층입니다.
            "service_tier": "fast"
          }
        },

        # synthesize는 lens 결과와 숙의 결과를 최종 리뷰 출력으로 종합합니다.
        "synthesize": {
          # synthesize도 격리된 worker에서 실행합니다.
          "seat": "worker",

          # 종합 단계는 더 깊은 추론이 필요할 수 있어 effort를 xhigh로 둡니다.
          "llm": {
            # oauth는 Codex 로그인 계정을 통해 OpenAI 모델을 사용합니다.
            "auth": "oauth",
            # provider는 사용할 모델 제공자입니다.
            "provider": "openai",
            # model은 사용할 모델 이름입니다.
            "model": "gpt-5.5",
            # effort는 추론 강도입니다. xhigh는 더 깊게 검토하지만 비용과 시간이 늘 수 있습니다.
            "effort": "xhigh",
            # service_tier는 Codex OAuth 경로에서 사용할 응답 속도 계층입니다.
            "service_tier": "fast"
          }
        }
      }
    }
  }
}
