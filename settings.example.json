# 이 파일을 .onto/settings.json 또는 ~/.onto/settings.json으로 복사해서 사용할 수 있습니다.
# JSON처럼 생겼지만 설명을 위해 # 주석을 허용합니다.
{
  # 설정 파일 구조 버전입니다. v3는 역할마다 모델 설정을 완전히 따로 둡니다.
  # 루트 llm.default나 역할 간 상속은 사용하지 않습니다.
  "schema_version": "settings.json/v3",

  # review는 코드나 문서 등을 검토하는 기능의 설정입니다.
  "review": {
    # full은 모든 review lens를 실행합니다. 빠른 검토가 필요하면 core-axis를 사용할 수 있습니다.
    "mode": "full",

    # 기본으로 사용할 도메인 목록입니다. 비워두면 실행 시 요청과 대상에서 추론합니다.
    "domains": ["software-engineering"],

    # context는 review 대상 주변 파일을 얼마나 읽을지 정합니다.
    "context": {
      # context 수집에서 제외할 폴더나 파일 이름입니다.
      "excluded_names": [".git", "node_modules", ".onto"],

      # 디렉터리 목록을 몇 단계 깊이까지 볼지 정합니다.
      "max_listing_depth": 10,

      # 디렉터리 목록에 넣을 최대 항목 수입니다.
      "max_listing_entries": 5000,

      # 한 파일에서 prompt에 넣을 최대 줄 수입니다.
      "max_embed_lines": 300
    },

    # execution은 review를 어떤 실행 구조와 모델로 돌릴지 정합니다.
    "execution": {
      # auto는 설정과 실행 환경을 보고 Codex worker나 direct-call 경로를 자동 선택합니다.
      "executor": "auto",

      # main-workers는 현재 세션이 진행을 조율하고, lens 작업은 worker가 수행합니다.
      "topology": "main-workers",

      # controlled-lens-deliberation은 lens 의견을 모아 필요한 쟁점을 숙의하는 기본 방식입니다.
      "deliberation": "controlled-lens-deliberation",

      # live는 실제 semantic path 산출물입니다. 테스트용 fixture/mock은 이 값을 명시적으로 바꿔야 합니다.
      "artifact_generation_realization": "live",

      # 한 번에 실행할 lens worker 수입니다. 값이 없으면 선택된 lens 전체를 병렬 실행합니다.
      "max_concurrent_lenses": 3,

      # actors는 review 안에서 역할별로 실제 모델 설정을 소유합니다.
      # 즉 teamlead, lens, synthesize를 서로 독립적으로 바꿀 수 있습니다.
      #
      # ── provider 전환 ───────────────────────────────────────────────
      # 손으로 고치는 대신 `onto configure-provider`가 아래 actor 블록을 검증 후
      # 기록합니다(units 등 다른 설정은 보존). 예:
      #   onto configure-provider --provider openai    --model gpt-5.5         --auth oauth --effort medium --service-tier fast
      #   onto configure-provider --provider anthropic --model claude-opus-4-8 --auth oauth --effort high
      # anthropic(Claude Code)로 손수 바꿀 때: 각 llm에서 provider를 "anthropic",
      # model을 "claude-opus-4-8"로 바꾸고 "service_tier" 줄을 삭제합니다
      # (service_tier는 openai+oauth 전용 — anthropic에 주면 거부됨).
      # configure-provider는 actor만 기록하므로, 아래 units[].llm.model도 같은
      # model로 바꾸거나 그 "model" 키를 지워 actor 값을 상속하게 하세요.
      # 지원 model id: .onto/authority/supported-models.yaml
      # ────────────────────────────────────────────────────────────────
      "actors": {
        # teamlead는 review 전체 진행과 숙의 조율을 담당합니다.
        "teamlead": {
          # main은 현재 실행 세션에서 조율한다는 뜻입니다.
          "seat": "main",

          # 이 역할이 사용할 모델 설정입니다. 다른 역할 설정을 상속하지 않습니다.
          "llm": {
            # oauth는 Codex 로그인 계정을 통해 OpenAI 모델을 사용합니다.
            "auth": "oauth",
            # provider는 사용할 모델 제공자입니다.
            "provider": "openai",
            # model은 사용할 모델 이름입니다.
            "model": "gpt-5.6-sol",
            # effort는 추론 강도입니다. 보통 medium이면 충분합니다.
            "effort": "medium",
            # service_tier는 Codex OAuth 경로에서 사용할 응답 속도 계층입니다.
            "service_tier": "fast"
          }
        },

        # lens는 실제 검토 관점을 독립적으로 실행하는 worker 역할입니다.
        "lens": {
          # worker는 별도 격리 실행 단위에서 작업한다는 뜻입니다.
          "seat": "worker",

          # lens worker가 사용할 모델 설정입니다.
          "llm": {
            # oauth는 Codex 로그인 계정을 통해 OpenAI 모델을 사용합니다.
            "auth": "oauth",
            # provider는 사용할 모델 제공자입니다.
            "provider": "openai",
            # model은 사용할 모델 이름입니다.
            "model": "gpt-5.6-sol",
            # effort는 추론 강도입니다. 보통 medium이면 충분합니다.
            "effort": "medium",
            # service_tier는 Codex OAuth 경로에서 사용할 응답 속도 계층입니다.
            "service_tier": "fast"
          }
        },

        # synthesize는 lens 결과와 숙의 결과를 최종 리뷰 출력으로 종합합니다.
        "synthesize": {
          # synthesize도 격리된 worker에서 실행합니다.
          "seat": "worker",

          # 종합 단계는 더 깊은 추론이 필요할 수 있어 effort를 xhigh로 둡니다.
          "llm": {
            # oauth는 Codex 로그인 계정을 통해 OpenAI 모델을 사용합니다.
            "auth": "oauth",
            # provider는 사용할 모델 제공자입니다.
            "provider": "openai",
            # model은 사용할 모델 이름입니다.
            "model": "gpt-5.6-sol",
            # effort는 추론 강도입니다. xhigh는 더 깊게 검토하지만 비용과 시간이 늘 수 있습니다.
            "effort": "xhigh",
            # service_tier는 Codex OAuth 경로에서 사용할 응답 속도 계층입니다.
            "service_tier": "fast"
          }
        }
      },

      # units는 pipeline 단계별 실행 정책입니다.
      # llm은 해당 단계의 기본 actor llm 위에 덮어씁니다.
      # 예: lens.effort만 xhigh로 올리면 provider/auth는 actors.lens.llm에서 옵니다.
      # 사용 가능한 unit id:
      # lens, finding_ledger, finding_relation_graph, issue_ledger,
      # issue_stance_matrix, deliberation_plan, problem_framing,
      # issue_stance_response, deliberation_response,
      # deliberation_resolution, synthesis_response
      # max_tokens/tool_mode은 direct_call/inline HTTP executor에서만 강제 가능합니다.
      # 기본 Codex OAuth worker 경로는 해당 knob를 강제할 수 없으므로 설정 시 fail-loud합니다.
      "units": {
        # lens는 9개 관점별 독립 검토입니다. 아래 값들은 decision-grade unit-sweep 결과입니다.
        # 기준: development-records/benchmark/review-unit-effort-all-units-low-medium-high-decision-rerun2-20260610-winner-selection-merged.json
        "lens": {
          "llm": {
            "model": "gpt-5.6-sol",
            "effort": "medium"
          },
          "timeout_ms": 240000,
          "max_retries": 2,
          "retry_initial_delay_ms": 3000,
          "max_output_bytes": 524288
        },
        "finding_ledger": {
          "llm": {
            "model": "gpt-5.6-sol",
            "effort": "medium"
          },
          "timeout_ms": 240000,
          "max_retries": 2,
          "retry_initial_delay_ms": 3000,
          "max_output_bytes": 524288
        },
        "finding_relation_graph": {
          "llm": {
            "model": "gpt-5.6-sol",
            "effort": "medium"
          },
          "timeout_ms": 240000,
          "max_retries": 2,
          "retry_initial_delay_ms": 3000,
          "max_output_bytes": 524288
        },
        "issue_ledger": {
          "llm": {
            "model": "gpt-5.6-sol",
            "effort": "medium"
          },
          "timeout_ms": 240000,
          "max_retries": 2,
          "retry_initial_delay_ms": 3000,
          "max_output_bytes": 524288
        },
        "deliberation_plan": {
          "llm": {
            "model": "gpt-5.6-sol",
            "effort": "medium"
          },
          "timeout_ms": 240000,
          "max_retries": 2,
          "retry_initial_delay_ms": 3000,
          "max_output_bytes": 524288
        },
        "problem_framing": {
          "llm": {
            "model": "gpt-5.6-sol",
            "effort": "medium"
          },
          "timeout_ms": 240000,
          "max_retries": 2,
          "retry_initial_delay_ms": 3000,
          "max_output_bytes": 524288
        },

        # issue_stance_matrix 자체는 runtime 집계지만, timeout/output 상한은 조정할 수 있습니다.
        "issue_stance_matrix": {
          "timeout_ms": 120000,
          "max_output_bytes": 524288
        },

        "issue_stance_response": {
          "llm": {
            "model": "gpt-5.6-sol",
            "effort": "medium"
          },
          "timeout_ms": 180000,
          "max_retries": 2,
          "retry_initial_delay_ms": 3000,
          "max_output_bytes": 524288
        },
        "deliberation_response": {
          "llm": {
            "model": "gpt-5.6-sol",
            "effort": "medium"
          },
          "timeout_ms": 180000,
          "max_retries": 2,
          "retry_initial_delay_ms": 3000,
          "max_output_bytes": 524288
        },
        # deliberation_resolution effort는 owner 지시(2026-07-17)로 sweep winner(low)를
        # override한 값입니다 — 근거는 settings-chain.test.ts의 OWNER_EFFORT_OVERRIDES 주석.
        "deliberation_resolution": {
          "llm": {
            "model": "gpt-5.6-sol",
            "effort": "medium"
          },
          "timeout_ms": 240000,
          "max_retries": 2,
          "retry_initial_delay_ms": 3000,
          "max_output_bytes": 524288
        },
        "synthesis_response": {
          "llm": {
            "model": "gpt-5.6-sol",
            "effort": "medium"
          },
          "timeout_ms": 180000,
          "max_retries": 2,
          "retry_initial_delay_ms": 3000,
          "max_output_bytes": 524288
        }
      }
    }
  },

  # reconstruct의 breaker-trip provider fallback은 기본적으로 꺼져 있습니다.
  # 활성화할 때는 enabled만 바꾸지 말고 strict enabled 형식의 trigger/limit/llm
  # 필드를 모두 명시해야 합니다. api_key 값 자체는 파일에 쓰지 않습니다.
  # enabled 형식:
  # "dispatch_fallback": {
  #   "enabled": true,
  #   "trigger": "rate_limit",
  #   "max_fallback_passes": 1,
  #   "per_dispatch_max_provider_attempts": 1,
  #   "systemic_failure_threshold": 1,
  #   "llm": {
  #     "provider": "anthropic", "auth": "api_key",
  #     "model": "<supported-model>", "effort": "medium",
  #     "api_key_env": "ANTHROPIC_API_KEY"
  #   }
  # }
  "reconstruct": {
    "execution": {
      # reconstruct actor도 역할별 독립 설정을 사용합니다.
      # semantic_author를 openai + api_key direct API 경로로 명시 전환한 경우에만
      # actor의 llm sibling인 llm_runtime.openai_responses_output_headroom_tokens를
      # 양의 정수로 추가할 수 있습니다. 생략하면 기존 stage output ceiling을 그대로 씁니다.
      # semantic_author/confirmation_provider = gpt-5.6-sol은 2026-07-17 role-확장
      # evidence run으로 등록된 값입니다 (supported-models.yaml sol 엔트리의
      # author/confirmation_provider roles + 인용 record 참조).
      "actors": {
        "semantic_author": {
          "llm": {
            "auth": "oauth",
            "provider": "openai",
            "model": "gpt-5.6-sol",
            "effort": "medium",
            "service_tier": "fast"
          }
        },
        "confirmation_provider": {
          "llm": {
            "auth": "oauth",
            "provider": "openai",
            "model": "gpt-5.6-sol",
            "effort": "medium",
            "service_tier": "fast"
          }
        }
      },
      "dispatch_fallback": {
        "enabled": false
      }
    }
  }
}
