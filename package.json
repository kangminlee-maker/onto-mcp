{
  "name": "onto-mcp",
  "version": "0.4.9",
  "description": "MCP-native ontology review runtime with context-isolated lenses and controlled deliberation",
  "homepage": "https://github.com/kangminlee-maker/onto-mcp#readme",
  "bugs": {
    "url": "https://github.com/kangminlee-maker/onto-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kangminlee-maker/onto-mcp.git"
  },
  "onto_release_channel": "beta",
  "onto_release_label": "onto-mcp-local-reset",
  "type": "module",
  "bin": {
    "onto": "bin/onto"
  },
  "files": [
    "bin/",
    "dist/",
    "scripts/check-retired-root-paths.sh",
    "scripts/onto-runtime-watch.sh",
    "scripts/onto-review-watch.sh",
    "scripts/postinstall-hint.js",
    ".onto/roles/",
    ".onto/domains/",
    ".onto/authority/",
    ".onto/processes/",
    ".onto/principles/",
    "CLAUDE.md",
    "AGENTS.md",
    "settings.example.json"
  ],
  "scripts": {
    "prepare": "npm run build:ts-core",
    "postinstall": "node scripts/postinstall-hint.js",
    "version:next": "node scripts/next-version.mjs",
    "clean:ts-core": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:ts-core": "npm run clean:ts-core && tsc -p tsconfig.json",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "check:ts-core": "tsc -p tsconfig.json --noEmit",
    "check:review:invocation-runner": "tsx scripts/review-invocation-runner-conformance.ts",
    "check:retired-root-paths": "bash scripts/check-retired-root-paths.sh",
    "check:mcp:review": "tsx scripts/mcp-review-conformance.ts",
    "check:review:route": "tsx scripts/review-runtime-hardening.ts",
    "check:import-boundary": "tsx scripts/check-import-boundary.ts",
    "check:spec-defaults": "tsx scripts/check-no-hardcoded-spec-defaults.ts",
    "check:invariant-change": "tsx scripts/check-invariant-change-marker.ts",
    "check:invariant-drift": "tsx scripts/check-invariant-drift.ts",
    "test": "npm run test:e2e",
    "test:review:live": "npm run build:ts-core && tsx scripts/review-mcp-live-e2e.ts",
    "test:review:live:cli": "npm run build:ts-core && tsx scripts/review-live-e2e.ts",
    "benchmark:review:pipeline": "tsx scripts/review-pipeline-benchmark.ts",
    "benchmark:reconstruct:pipeline": "tsx scripts/reconstruct-pipeline-benchmark.ts",
    "migrate:reconstruct-artifact-fields": "tsx scripts/migrate-reconstruct-artifact-fields.ts",
    "test:e2e": "npm run build:ts-core && tsx scripts/review-mcp-live-e2e.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.99.0",
    "openai": "^6.33.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
