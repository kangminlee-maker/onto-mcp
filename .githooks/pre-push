#!/usr/bin/env bash
# 커밋되는 pre-push 훅. 클론마다 한 번 켠다:
#
#   git config core.hooksPath .githooks
#
# `.git/hooks`가 아니라 레포 안에 사는 이유는, 규칙이 노트북 한 대가 아니라
# 코드와 함께 이동해야 하기 때문이다.
#
# stdin으로 들어오는 것: <local ref> <local sha> <remote ref> <remote sha>
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ZERO='0000000000000000000000000000000000000000'
fail=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue          # 브랜치 삭제
  if [ "$remote_sha" = "$ZERO" ]; then
    # 원격에 처음 올리는 브랜치: 머지될 base 기준으로 판정한다.
    #
    # base를 못 구하면 건너뛰지 않는다 — 건너뛰기는 통과처럼 보이는데 실제로는
    # 아무것도 검사하지 않은 것이다. origin/main을 fetch하지 않은 클론에서 정확히
    # 그렇게 되고, 그 클론에서는 게이트가 영원히 조용하다.
    if ! base="$(git merge-base origin/main "$local_sha" 2>/dev/null)" || [ -z "$base" ]; then
      echo "pre-push: FAILED — origin/main 과의 merge-base를 구할 수 없다." >&2
      echo "  검사하지 못한 것은 통과가 아니다. 'git fetch origin main' 후 다시 push 한다." >&2
      fail=1
      continue
    fi
    range="$base..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  bash "$ROOT/scripts/check-push-currency.sh" "$range" || fail=1
done

exit "$fail"
