# onto runtime data — per-session / ephemeral artifacts only.
# Structural resources under `.onto/` (domains/, roles/, processes/,
# principles/, authority/) are versioned and intentionally NOT ignored.
# If a new runtime-ephemeral
# subdirectory is added under `.onto/`, add its pattern here explicitly.
# CI guard: scripts/check-onto-allowlist.sh fails when a tracked `.onto/` path
# is neither in its structural allowlist nor covered by this file.
#
.onto/review/
.onto/builds/
.onto/learnings/
.onto/govern/
.onto/reconstruct/
.onto/temp/
.onto-review/
.claude/

# evolve scope artifacts (ephemeral design sessions)
scopes/
.sprint-kit/cache/
.DS_Store
__pycache__/
*.pyc
node_modules/
dist/

# .mcpb Desktop Extension build output (scripts/build-mcpb.mjs).
# packaging/ and manifest.json are source — intentionally NOT ignored.
build/

# local env secrets (never commit)
.env


# B4 synthesize-cert bench: the durable record+capsule in each run dir ARE
# tracked; the local/ sidecar holds real-workbook-derived child-summary PROSE
# (source-safety: sha-referenced from the capsule, never committed).
development-records/benchmark/synthesize-cert/*/local/

# review-cert bench: the canonical committed set per run dir is README.md,
# capture/*.jsonl, review-cert-record.json, and runs/rows.progress.jsonl. The
# per-attempt run artifacts (baseline/candidate *.json/.log/.partial.json) and
# rejected-record variants are scratch — never committed.
development-records/benchmark/review-cert/*/runs/*
!development-records/benchmark/review-cert/*/runs/rows.progress.jsonl
development-records/benchmark/review-cert/*/review-cert-record.rejected.json
development-records/benchmark/review-cert/*/run*.log
development-records/benchmark/review-cert/*/shim/

# 20260712-101717 was aborted (rep_floor cut) and superseded; only its tracked
# stance-rejection-diagnosis.md is kept — the incomplete capture/record/rows are scratch.
development-records/benchmark/review-cert/20260712-101717/capture/
development-records/benchmark/review-cert/20260712-101717/review-cert-record.json
development-records/benchmark/review-cert/20260712-101717/runs/rows.progress.jsonl

# evidence/: promoting a run dir carries its untracked sidecars along on disk, so
# the same rules hold at the new location. The source-safety one is why: local/
# holds real-workbook-derived prose that is sha-referenced from the capsule and
# never committed — a promotion must not be a way around that.
evidence/synthesize-cert/*/local/
evidence/review-cert/*/runs/*
!evidence/review-cert/*/runs/rows.progress.jsonl
evidence/review-cert/*/review-cert-record.rejected.json
evidence/review-cert/*/run*.log
evidence/review-cert/*/shim/
scripts/.code-probe-out/

# Probe/benchmark WORKING area at the repo root. Harnesses under `scripts/` write here
# (raw transcripts, input copies, reviewer reasoning traces), and it grows without bound —
# 19 MB by 2026-07-29. Nothing durable lives here: a record a document CITES is promoted
# out — into `development-records/benchmark/<name>/` when an isolated document cites it,
# into `evidence/` when an active one does. Both are tracked; see that tree's
# PROVENANCE-promoted.md and evidence/README.md, and docs/architecture/repo-layout.md
# for which destination applies to whom.
/benchmark/
