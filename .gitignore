# onto runtime data — per-session / ephemeral artifacts only.
# Structural resources under `.onto/` (domains/, roles/, processes/,
# principles/, authority/) are versioned and intentionally NOT ignored.
# If a new runtime-ephemeral
# subdirectory is added under `.onto/`, add its pattern here explicitly.
# CI guard: scripts/check-onto-allowlist.sh fails when a tracked `.onto/` path
# is neither in its structural allowlist nor covered by this file.
#
.onto/review/
.onto/builds/
.onto/learnings/
.onto/govern/
.onto/reconstruct/
.onto/temp/
.onto-review/
.claude/

# evolve scope artifacts (ephemeral design sessions)
scopes/
.sprint-kit/cache/
.DS_Store
__pycache__/
*.pyc
node_modules/
dist/

# .mcpb Desktop Extension build output (scripts/build-mcpb.mjs).
# packaging/ and manifest.json are source — intentionally NOT ignored.
build/

# local env secrets (never commit)
.env

# B4 synthesize-cert bench: the durable record+capsule in each run dir ARE
# tracked; the local/ sidecar holds real-workbook-derived child-summary PROSE
# (source-safety: sha-referenced from the capsule, never committed).
development-records/benchmark/synthesize-cert/*/local/
