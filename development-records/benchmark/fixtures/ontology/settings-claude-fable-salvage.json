      },
      "actors": {
        "teamlead": {
          "seat": "main",
          "llm": {
            "auth": "oauth",
            "provider": "anthropic",
            "model": "claude-fable-5"
          }
        },
        "lens": {
          "seat": "worker",
          "llm": {
            "auth": "oauth",
            "provider": "anthropic",
            "model": "claude-fable-5"
          }
        },
        "synthesize": {
          "seat": "worker",
          "llm": {
            "auth": "oauth",
            "provider": "anthropic",
            "model": "claude-fable-5"
          }
        }
      }
    }
  },
  "reconstruct": {
