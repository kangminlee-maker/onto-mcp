{
  "schema_version": "settings.json/v3",
  "review": {
    "mode": "full",
    "domains": [],
    "context": {
      "excluded_names": [
        ".git",
        "node_modules",
        ".onto"
      ],
      "max_listing_depth": 10,
      "max_listing_entries": 5000,
      "max_embed_lines": 300
    },
    "artifacts": {
      "lens_output_format": "sidecar",
      "write_lens_markdown": false
    },
    "execution": {
      "topology": "main-workers",
      "deliberation": "controlled-lens-deliberation",
      "artifact_generation_realization": "live",
      "max_concurrent_lenses": 3,
      "retry": {
        "lens_max_retries": 2,
        "issue_artifact_max_retries": 2,
        "deliberation_max_retries": 2,
        "synthesis_max_retries": 2,
        "retry_initial_delay_ms": 3000,
        "salvage": {
          "enabled": true,
          "transcription_llm": {
            "model": "claude-haiku-4-5-20251001"
          }
        }
      },
      "units": {
        "lens": {
          "llm": {
            "model": "claude-fable-5",
            "effort": "medium"
          },
          "timeout_ms": 600000,
          "max_retries": 2,
          "retry_initial_delay_ms": 3000,
          "max_output_bytes": 524288
        },
        "finding_ledger": {
          "llm": {
            "model": "claude-fable-5",
            "effort": "medium"
          },
          "timeout_ms": 600000,
          "max_retries": 2,
          "retry_initial_delay_ms": 3000,
          "max_output_bytes": 524288
        },
        "finding_relation_graph": {
          "llm": {
            "model": "claude-fable-5",
            "effort": "high"
          },
          "timeout_ms": 600000,
          "max_retries": 2,
          "retry_initial_delay_ms": 3000,
          "max_output_bytes": 524288
        },
        "issue_ledger": {
          "llm": {
            "model": "claude-fable-5",
            "effort": "high"
          },
          "timeout_ms": 600000,
          "max_retries": 2,
          "retry_initial_delay_ms": 3000,
          "max_output_bytes": 524288
        },
        "issue_stance_matrix": {
          "timeout_ms": 300000,
          "max_output_bytes": 524288
        },
        "deliberation_plan": {
          "llm": {
            "model": "claude-fable-5",
            "effort": "medium"
          },
          "timeout_ms": 600000,
          "max_retries": 2,
          "retry_initial_delay_ms": 3000,
          "max_output_bytes": 524288
        },
        "problem_framing": {
          "llm": {
            "model": "claude-fable-5",
            "effort": "high"
          },
          "timeout_ms": 600000,
          "max_retries": 2,
          "retry_initial_delay_ms": 3000,
          "max_output_bytes": 524288
        },
        "issue_stance_response": {
          "llm": {
            "model": "claude-fable-5",
            "effort": "medium"
          },
          "timeout_ms": 600000,
          "max_retries": 2,
          "retry_initial_delay_ms": 3000,
          "max_output_bytes": 524288
        },
        "deliberation_response": {
          "llm": {
            "model": "claude-fable-5",
            "effort": "medium"
          },
          "timeout_ms": 600000,
          "max_retries": 2,
          "retry_initial_delay_ms": 3000,
          "max_output_bytes": 524288
        },
        "deliberation_resolution": {
          "llm": {
            "model": "claude-fable-5",
            "effort": "high"
          },
          "timeout_ms": 600000,
          "max_retries": 2,
          "retry_initial_delay_ms": 3000,
